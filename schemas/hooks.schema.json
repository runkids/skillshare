{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/runkids/skillshare/main/schemas/hooks.schema.json",
  "title": "Skillshare Hooks",
  "description": "One hook entry as read by 'skillshare hooks add|edit --file'. The same definitions describe the hooks section of config.yaml.",
  "$ref": "#/$defs/globalEntry",
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"},
    "commandBinding": {
      "type": "object", "additionalProperties": false, "required": ["events"],
      "properties": {
        "events": {
          "type": "object", "minProperties": 1,
          "description": "The Agent's own native event map, written without translation: event names, matchers, timeout units and handler fields stay exactly as the Agent documents them.",
          "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
          "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "object"}}
        },
        "files": {
          "type": "object",
          "description": "Script files written to <Agent config dir>/hooks/skillshare/<entry>/. Commands must reference them by path themselves.",
          "propertyNames": {"$ref": "#/$defs/name"},
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "codeBinding": {
      "type": "object", "additionalProperties": false, "required": ["code"],
      "properties": {"code": {"type": "string", "minLength": 1, "description": "One standalone native TypeScript/JavaScript extension or plugin, written verbatim as skillshare-<entry>.ts. It must use the plugin API of the installed Agent version."}}
    },
    "gitBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands"
      ],
      "properties": {
        "commands": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "not": {
              "anyOf": [
                {
                  "enum": [
                    "applypatch-msg",
                    "pre-applypatch",
                    "post-applypatch",
                    "pre-commit",
                    "pre-merge-commit",
                    "prepare-commit-msg",
                    "commit-msg",
                    "post-commit",
                    "pre-rebase",
                    "post-checkout",
                    "post-merge",
                    "pre-push",
                    "pre-receive",
                    "update",
                    "proc-receive",
                    "post-receive",
                    "post-update",
                    "reference-transaction",
                    "push-to-checkout",
                    "pre-auto-gc",
                    "post-rewrite",
                    "sendemail-validate",
                    "fsmonitor-watchman",
                    "p4-changelist",
                    "p4-prepare-changelist",
                    "p4-post-changelist",
                    "p4-pre-submit",
                    "post-index-change"
                  ]
                },
                {
                  "pattern": "\\.\\.|\\.$"
                }
              ]
            }
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "events",
              "command"
            ],
            "properties": {
              "events": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                }
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\n\\r\\u0000]+$"
              },
              "parallel": {
                "type": "boolean",
                "description": "Requires Git 2.55+."
              }
            }
          }
        },
        "files": {
          "type": "object",
          "description": "Executable Git helpers under <git config dir>/skillshare/files/<entry>/ (project: <git-common-dir>/skillshare/files/<entry>/); reference with {files}/<name>. Commands must reference them by path themselves.",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "bindings": {
      "type": "object", "additionalProperties": false,
      "description": "Keyed by Agent. An empty map keeps the hook in Skillshare without publishing it. factory is an alias for droid; antigravity-cli and agy are aliases for antigravity.",
      "properties": {
        "git": {"$ref": "#/$defs/gitBinding"},
        "claude": {"$ref": "#/$defs/commandBinding"},
        "codex": {"$ref": "#/$defs/commandBinding"},
        "gemini": {"$ref": "#/$defs/commandBinding"},
        "qwen": {"$ref": "#/$defs/commandBinding"},
        "copilot": {"$ref": "#/$defs/commandBinding"},
        "cursor": {"$ref": "#/$defs/commandBinding"},
        "droid": {"$ref": "#/$defs/commandBinding"},
        "factory": {"$ref": "#/$defs/commandBinding"},
        "antigravity": {"$ref": "#/$defs/commandBinding"},
        "antigravity-cli": {"$ref": "#/$defs/commandBinding"},
        "agy": {"$ref": "#/$defs/commandBinding"},
        "pi": {"$ref": "#/$defs/codeBinding"},
        "omp": {"$ref": "#/$defs/codeBinding"},
        "amp": {"$ref": "#/$defs/codeBinding"},
        "opencode": {"$ref": "#/$defs/codeBinding"}
      }
    },
    "globalBindings": {
      "type": "object", "additionalProperties": false,
      "description": "Account keys are declared under targets with agent and config_dir and are valid in global config only.",
      "properties": {
        "git": {"$ref": "#/$defs/gitBinding"},
        "claude": {"$ref": "#/$defs/commandBinding"},
        "codex": {"$ref": "#/$defs/commandBinding"},
        "gemini": {"$ref": "#/$defs/commandBinding"},
        "qwen": {"$ref": "#/$defs/commandBinding"},
        "copilot": {"$ref": "#/$defs/commandBinding"},
        "cursor": {"$ref": "#/$defs/commandBinding"},
        "droid": {"$ref": "#/$defs/commandBinding"},
        "factory": {"$ref": "#/$defs/commandBinding"},
        "antigravity": {"$ref": "#/$defs/commandBinding"},
        "antigravity-cli": {"$ref": "#/$defs/commandBinding"},
        "agy": {"$ref": "#/$defs/commandBinding"},
        "pi": {"$ref": "#/$defs/codeBinding"},
        "omp": {"$ref": "#/$defs/codeBinding"},
        "amp": {"$ref": "#/$defs/codeBinding"},
        "opencode": {"$ref": "#/$defs/codeBinding"}
      },
      "patternProperties": {
        "^(?!(claude|codex|gemini|qwen|copilot|cursor|droid|factory|antigravity|antigravity-cli|agy|pi|omp|amp|opencode|git)$)[A-Za-z0-9][A-Za-z0-9._-]*$": {
          "description": "Account keys are declared under targets with agent and config_dir and are valid in global config only.",
          "anyOf": [{"$ref": "#/$defs/commandBinding"}, {"$ref": "#/$defs/codeBinding"}]
        }
      }
    },
    "globalEntry": {
      "type": "object", "additionalProperties": false, "required": ["bindings"],
      "description": "Account keys are declared under targets with agent and config_dir and are valid in global config only.",
      "properties": {
        "description": {"type": "string"},
        "enabled": {"type": "boolean", "default": true, "description": "false keeps the definition and removes only its unchanged native outputs."},
        "bindings": {"$ref": "#/$defs/globalBindings"}
      }
    },
    "globalEntries": {
      "type": "object", "description": "Account keys are declared under targets with agent and config_dir and are valid in global config only.",
      "propertyNames": {"$ref": "#/$defs/name"}, "additionalProperties": {"$ref": "#/$defs/globalEntry"}
    },
    "entry": {
      "type": "object", "additionalProperties": false, "required": ["bindings"],
      "properties": {
        "description": {"type": "string"},
        "enabled": {"type": "boolean", "default": true, "description": "false keeps the definition and removes only its unchanged native outputs."},
        "bindings": {"$ref": "#/$defs/bindings"}
      }
    },
    "entries": {"type": "object", "propertyNames": {"$ref": "#/$defs/name"}, "additionalProperties": {"$ref": "#/$defs/entry"}},
    "configuration": {
      "type": "object", "additionalProperties": false,
      "properties": {"entries": {"$ref": "#/$defs/entries"}}
    },
    "globalConfiguration": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entries": {"$ref": "#/$defs/globalEntries"},
        "projects": {
          "type": "object",
          "description": "Project roots this global config publishes hooks into, keyed by absolute path or ~ path. A root with its own Skillshare config is managed there instead.",
          "additionalProperties": {"type": "object", "additionalProperties": false, "properties": {"entries": {"$ref": "#/$defs/entries"}}}
        }
      }
    }
  }
}
